# Apenas Kind. Nenhuma credencial ou URL de produção.
PORT=8080
DB_URL=jdbc:postgresql://postgres:5432/service_order_db
DB_USERNAME=os_user
branch-id=40000000-0000-4000-8000-000000000001
BILLING_BASE_URL=http://numberone-billing-service:8081
INVENTORY_BASE_URL=http://numberone-inventory-service:8082
APP_MATERIAL_REFERENCE_PROVIDER=http
BILLING_SQS_ENABLED=true
BILLING_SQS_MODE=dedicated
BILLING_SQS_ENDPOINT=http://localstack:4566
BILLING_SQS_QUEUE_URL=http://localstack:4566/queue/us-east-1/000000000000/numberone-billing-events
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_EC2_METADATA_DISABLED=true
HISTORY_DYNAMODB_ENABLED=true
HISTORY_WORKER_ENABLED=true
SAGA_RECOVERY_ENABLED=true
STATSD_ENABLED=false
DD_ENV=kind
DD_TRACE_ENABLED=false
DD_INSTRUMENTATION_TELEMETRY_ENABLED=false
DD_REMOTE_CONFIGURATION_ENABLED=false
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=65 -XX:ActiveProcessorCount=2
HISTORY_DYNAMODB_TABLE=vehicle_maintenance_history
HISTORY_DYNAMODB_ENDPOINT=http://localstack-dynamodb:4566
SPRING_TASK_SCHEDULING_POOL_SIZE=3
