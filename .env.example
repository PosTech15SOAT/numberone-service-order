OS_HTTP_PORT=18080
DD_SERVICE=numberone-service-order
DD_ENV=local
DD_TRACE_ENABLED=false
OS_BRANCH_ID=40000000-0000-4000-8000-000000000001
# Explicit demonstration fixture; never represents a live Inventory integration.
MATERIAL_REFERENCE_PROVIDER=unavailable
# Non-secret local settings only. Compose uses a disposable development credential.
BILLING_SQS_ENABLED=false
BILLING_SQS_MODE=disabled
# Phase 4 implements all five active handlers; dedicated/shared must be explicit.
# BILLING_SQS_MODE=dedicated
# BILLING_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT/dedicated-billing-os
# AWS_REGION=us-east-1
# Optional emulator endpoint; credentials come from the default AWS provider chain.
# BILLING_SQS_ENDPOINT=http://localhost:4566
# Internal URLs without trailing slash; use private TLS outside tests.
BILLING_BASE_URL=
INVENTORY_BASE_URL=
# Pair-specific secrets supplied by the environment/Secret, never committed values.
OS_TO_BILLING_TOKEN=
OS_TO_INVENTORY_TOKEN=
BILLING_TO_OS_TOKEN=

# Fase 5: retomada local, leases de 30s, intervalo entre varreduras
SAGA_RECOVERY_ENABLED=true
SAGA_RECOVERY_DELAY_MS=5000
