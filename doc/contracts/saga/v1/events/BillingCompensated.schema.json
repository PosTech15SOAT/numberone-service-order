{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.numberone.invalid/saga/v1/events/BillingCompensated.schema.json",
  "title": "BillingCompensated",
  "description": "Rascunho v1. billing-service -> os-service. Não aprovado pela equipe.",
  "allOf": [
    {
      "$ref": "https://contracts.numberone.invalid/saga/v1/envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "BillingCompensated"
        },
        "producer": {
          "const": "billing-service"
        },
        "causationId": {
          "$ref": "https://contracts.numberone.invalid/saga/v1/common.schema.json#/$defs/uuid"
        },
        "payload": {
          "type": "object",
          "properties": {
            "budgetRevision": {
              "$ref": "https://contracts.numberone.invalid/saga/v1/common.schema.json#/$defs/revision"
            },
            "result": {
              "enum": [
                "NOT_CHARGED",
                "CANCELLED",
                "REFUNDED"
              ]
            },
            "budgetId": {
              "$ref": "https://contracts.numberone.invalid/saga/v1/common.schema.json#/$defs/uuid"
            },
            "paymentAttemptId": {
              "$ref": "https://contracts.numberone.invalid/saga/v1/common.schema.json#/$defs/uuid"
            },
            "paymentReference": {
              "$ref": "https://contracts.numberone.invalid/saga/v1/common.schema.json#/$defs/reference"
            },
            "refundReference": {
              "$ref": "https://contracts.numberone.invalid/saga/v1/common.schema.json#/$defs/reference"
            },
            "compensatedAt": {
              "$ref": "https://contracts.numberone.invalid/saga/v1/common.schema.json#/$defs/utc"
            }
          },
          "required": [
            "budgetRevision",
            "result",
            "compensatedAt"
          ],
          "additionalProperties": true,
          "allOf": [
            {
              "if": {
                "properties": {
                  "result": {
                    "const": "REFUNDED"
                  }
                }
              },
              "then": {
                "required": [
                  "budgetId",
                  "paymentAttemptId",
                  "paymentReference",
                  "refundReference"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "result": {
                    "const": "CANCELLED"
                  }
                }
              },
              "then": {
                "required": [
                  "budgetId",
                  "paymentAttemptId"
                ]
              }
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": true
    }
  ]
}
