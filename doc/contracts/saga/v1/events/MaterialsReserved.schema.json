{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.numberone.invalid/saga/v1/events/MaterialsReserved.schema.json",
  "title": "MaterialsReserved",
  "description": "Rascunho v1. inventory-service -> os-service. Não aprovado pela equipe.",
  "allOf": [
    {
      "$ref": "https://contracts.numberone.invalid/saga/v1/envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "MaterialsReserved"
        },
        "producer": {
          "const": "inventory-service"
        },
        "causationId": {
          "$ref": "https://contracts.numberone.invalid/saga/v1/common.schema.json#/$defs/uuid"
        },
        "payload": {
          "type": "object",
          "properties": {
            "budgetRevision": {
              "$ref": "https://contracts.numberone.invalid/saga/v1/common.schema.json#/$defs/revision"
            },
            "reservationId": {
              "$ref": "https://contracts.numberone.invalid/saga/v1/common.schema.json#/$defs/uuid"
            },
            "allocations": {
              "type": "array",
              "items": {
                "$ref": "https://contracts.numberone.invalid/saga/v1/common.schema.json#/$defs/allocation"
              },
              "minItems": 1
            }
          },
          "required": [
            "budgetRevision",
            "reservationId",
            "allocations"
          ],
          "additionalProperties": true
        }
      },
      "required": [],
      "additionalProperties": true
    }
  ]
}
