{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.numberone.invalid/saga/v1/events/MaterialsReleased.schema.json",
  "title": "MaterialsReleased",
  "description": "Rascunho v1. inventory-service -> os-service. Não aprovado pela equipe.",
  "allOf": [
    {
      "$ref": "https://contracts.numberone.invalid/saga/v1/envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "MaterialsReleased"
        },
        "producer": {
          "const": "inventory-service"
        },
        "causationId": {
          "$ref": "https://contracts.numberone.invalid/saga/v1/common.schema.json#/$defs/uuid"
        },
        "payload": {
          "type": "object",
          "properties": {
            "budgetRevision": {
              "$ref": "https://contracts.numberone.invalid/saga/v1/common.schema.json#/$defs/revision"
            },
            "reservationId": {
              "$ref": "https://contracts.numberone.invalid/saga/v1/common.schema.json#/$defs/uuid"
            },
            "releasedAt": {
              "$ref": "https://contracts.numberone.invalid/saga/v1/common.schema.json#/$defs/utc"
            },
            "result": {
              "enum": [
                "RELEASED",
                "NOT_RESERVED"
              ]
            }
          },
          "required": [
            "budgetRevision",
            "releasedAt",
            "result"
          ],
          "additionalProperties": true,
          "allOf": [
            {
              "if": {
                "properties": {
                  "result": {
                    "const": "RELEASED"
                  }
                }
              },
              "then": {
                "required": [
                  "reservationId"
                ]
              }
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": true
    }
  ]
}
