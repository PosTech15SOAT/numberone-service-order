{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.numberone.invalid/saga/v1/events/PaymentPending.schema.json",
  "title": "PaymentPending",
  "description": "Rascunho v1. billing-service -> os-service. Não aprovado pela equipe.",
  "allOf": [
    {
      "$ref": "https://contracts.numberone.invalid/saga/v1/envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "PaymentPending"
        },
        "producer": {
          "const": "billing-service"
        },
        "causationId": {
          "$ref": "https://contracts.numberone.invalid/saga/v1/common.schema.json#/$defs/uuid"
        },
        "payload": {
          "type": "object",
          "properties": {
            "budgetRevision": {
              "$ref": "https://contracts.numberone.invalid/saga/v1/common.schema.json#/$defs/revision"
            },
            "budgetId": {
              "$ref": "https://contracts.numberone.invalid/saga/v1/common.schema.json#/$defs/uuid"
            },
            "paymentAttemptId": {
              "$ref": "https://contracts.numberone.invalid/saga/v1/common.schema.json#/$defs/uuid"
            },
            "checkoutReference": {
              "$ref": "https://contracts.numberone.invalid/saga/v1/common.schema.json#/$defs/reference"
            },
            "checkoutUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 2048
            }
          },
          "required": [
            "budgetRevision",
            "budgetId",
            "paymentAttemptId",
            "checkoutReference"
          ],
          "additionalProperties": true
        }
      },
      "required": [],
      "additionalProperties": true
    }
  ]
}
