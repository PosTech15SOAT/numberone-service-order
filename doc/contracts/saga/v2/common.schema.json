{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.numberone.invalid/saga/v2/common.schema.json",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "money": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$",
      "maxLength": 20
    },
    "positiveMoney": {
      "allOf": [
        {
          "$ref": "https://contracts.numberone.invalid/saga/v2/common.schema.json#/$defs/money"
        },
        {
          "not": {
            "const": "0.00"
          }
        }
      ]
    }
  }
}
